(* driver module generated by Coco-R *)
MODULE -->modulename;
  (* a console driver for polpo: a command of the shell of polpo, the file to parse is
     taken as its argument. The log of the run is written to Oberon0.Log, as every tool of
     polpo does, and shown on the terminal. *)

  IMPORT S:=-->scanner, P:=-->parser, Oberon0, Texts := texts, out;

  CONST minErrDist = 8;

  VAR W: Texts.Writer; lastErrPos: LONGINT;

  PROCEDURE Error (n: INTEGER; pos: LONGINT);

    PROCEDURE Msg (s: ARRAY OF CHAR);
    BEGIN
      Texts.WriteString(W, s)
    END Msg;

  BEGIN
    INC(S.errors);
    IF pos < lastErrPos + minErrDist THEN lastErrPos := pos; RETURN END;
    lastErrPos := pos;
    Texts.WriteString(W, "  pos "); Texts.WriteInt(W, pos, 4); Texts.WriteString(W, ": ");
    IF n < 200 THEN
      CASE n OF-->errors
      ELSE Texts.WriteString(W, "error "); Texts.WriteInt(W, n, 0)
      END
    ELSE Texts.WriteString(W, "error "); Texts.WriteInt(W, n, 0)
    END;
    Texts.WriteLn(W); Texts.Append(Oberon0.Log, W.buf)
  END Error;

  (* what was appended to the log since position pos *)
  PROCEDURE ShowLog(pos: LONGINT);
    VAR R: Texts.Reader; ch: CHAR;
  BEGIN
    IF Oberon0.Log.len > pos THEN
      Texts.OpenReader(R, Oberon0.Log, pos);
      Texts.Read(R, ch);
      WHILE ~R.eot DO
        IF ch = 0DX THEN out.Ln ELSE out.Char(ch) END;
        Texts.Read(R, ch)
      END
    END
  END ShowLog;

  PROCEDURE Do*;
    VAR A: Texts.Reader; arg: ARRAY 512 OF CHAR; src: Texts.Text; pos: LONGINT;
  BEGIN
    Texts.OpenWriter(W);
    pos := Oberon0.Log.len;
    Texts.OpenArgs(A);
    IF ~Texts.Arg(A, arg) THEN
      Texts.WriteString(W, "usage: <file>"); Texts.WriteLn(W);
      Texts.Append(Oberon0.Log, W.buf); ShowLog(pos); RETURN
    END;
    NEW(src); Texts.Open(src, arg);
    IF src.len = 0 THEN
      Texts.WriteString(W, "cannot read "); Texts.WriteString(W, arg); Texts.WriteLn(W);
      Texts.Append(Oberon0.Log, W.buf); ShowLog(pos); RETURN
    END;
    Texts.WriteString(W, "-->name: "); Texts.WriteString(W, arg); Texts.WriteLn(W);
    Texts.Append(Oberon0.Log, W.buf);
    S.Reset(src, 0, Error); lastErrPos := -10;
    P.Parse;
    Texts.WriteInt(W, S.errors, 0); Texts.WriteString(W, " errors"); Texts.WriteLn(W);
    Texts.Append(Oberon0.Log, W.buf);
    ShowLog(pos)
  END Do;

END -->modulename.